# ==============================================================================
# Civic-I: Smart City Reporter Environment Configuration
# Copy this file to .env before starting the development server.
# NEVER commit real API keys, credentials, or secrets to version control.
# ==============================================================================

# --- Local AI (Ollama) Dual-Model Configuration ---
# Vision Model: Gemma 3 (4B size or larger required; 1B size cannot read images).
# Used for photo inspection and civic issue visual classification.
VITE_OLLAMA_VISION_MODEL=gemma3:4b

# Decision Model: Llama 3 (text-only model).
# Evaluates text facts only (safety risk, traffic exposure, priority, department).
# Never receives images, user names, or personal details.
VITE_OLLAMA_TEXT_MODEL=llama3

# Base URL for the local Ollama instance (proxied in development through Vite at /ollama).
OLLAMA_BASE_URL=http://localhost:11434

# --- Firebase Authentication Configuration (Google Sign-In Only) ---
# Required for Google Sign-In via Firebase Auth.
# If these variables are not configured, the app provides a clearly marked [DEMO] login button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Mapping Configuration (Leaflet + OpenStreetMap) ---
# Leaflet with OpenStreetMap is used for mapping. No API keys or billing required!
# Tiles: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Geocoding: OpenStreetMap Nominatim API (1 request/second rate-limited).
# For heavy production usage, configure a dedicated tile & Nominatim provider.

# --- Legacy Backend / API Placeholders ---
# Preserved for future municipal backend microservice integration.
DATABASE_URL=
JWT_SECRET=
STORAGE_DIR=
VITE_API_URL=
