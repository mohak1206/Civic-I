# ==============================================================================
# Civic-I: Smart City Reporter Environment Configuration
# Copy this file to .env before starting the development server.
# NEVER commit real API keys, credentials, or secrets to version control.
# ==============================================================================

# --- Google Maps Platform Configuration ---
# Your Google Maps JavaScript API key (must have Maps JavaScript API & Geocoding API enabled).
# Restrict this key by HTTP referrer (e.g. http://localhost:3000/* in development).
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID configured for JavaScript / Vector / Advanced Markers.
# For local testing, you can use the official demo map ID: DEMO_MAP_ID
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Local AI (Ollama) Configuration ---
# Name of the vision-capable Ollama model to use for civic issue photo classification.
# Example: llava, llama3.2-vision, or bakllava.
# The user selects the model; do not hardcode. If unset or unavailable, manual category selection is provided.
VITE_OLLAMA_MODEL=

# Base URL for the local Ollama instance (proxied in development through Vite at /ollama).
OLLAMA_BASE_URL=http://localhost:11434

# --- Firebase Authentication Configuration (Google Sign-In Only) ---
# Required for Google Sign-In via Firebase Auth.
# If these variables are not configured, the app provides a clearly marked [DEMO] login button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Legacy Backend / API Placeholders ---
# Preserved for future municipal backend microservice integration.
DATABASE_URL=
JWT_SECRET=
STORAGE_DIR=
VITE_API_URL=
